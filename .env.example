# Notion internal integration secret (starts with "ntn_" or "secret_")
# Create one at https://www.notion.so/my-integrations
NOTION_TOKEN=

# The database ID (from the database URL) that has been shared with the integration above
NOTION_DATABASE_ID=

# Database ID of the small "Web Dashboard Users" database that stores webapp
# login accounts (name/PIN/role). Must also be shared with the integration.
NOTION_USERS_DATABASE_ID=

# Random secret used to sign login session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
